      "css": ".ds-card{display:grid;grid-template-columns:104px minmax(0,1fr);gap:22px;padding:26px;border-radius:16px;background:#fff;color:#15365b;font-family:'Nunito Sans','Segoe UI',sans-serif;}.ds-copy{display:flex;flex-direction:column;align-items:flex-start;min-width:0}.ds-copy h3{margin:0;font-size:1.375rem;line-height:1.3;font-weight:700}.ds-skill{margin:6px 0 0;font-size:.875rem;line-height:1.5;color:#1f5bb0}.ds-description{margin:14px 0 20px;font-size:1rem;line-height:1.55;color:#4e6680;max-width:65ch}.ds-card-play{display:inline-flex;align-items:center;justify-content:center;gap:20px;border:0;font-family:'Nunito Sans','Segoe UI',sans-serif;font-size:1rem;font-weight:700;cursor:pointer;min-height:44px;padding:9px 16px;border-radius:9px;margin-top:auto;background:#edf4ff;color:#194fac}.ds-card-play:hover{background:#d4e5ff}.ds-card-play:active{background:#bed5fa}.ds-board{display:grid;grid-template-columns:repeat(3,1fr);width:100px;gap:4px;transform:rotate(-5deg);font-family:'Nunito Sans','Segoe UI',sans-serif;}.ds-board span{display:grid;place-items:center;height:30px;background:#e4edff;border-radius:5px;color:#2351a0;font-size:17px;font-weight:700}.ds-board span:nth-child(2n){background:#f0f5ff}@media(max-width:1000px){.ds-card{grid-template-columns:76px minmax(0,1fr);padding:24px;gap:18px}.ds-board{width:76px}}@media(max-width:359px){.ds-card{grid-template-columns:60px minmax(0,1fr);padding:20px;gap:14px}.ds-board{width:60px;gap:2px}}.ds-focus:focus-visible{outline:3px solid #1f70d1;outline-offset:4px}"
