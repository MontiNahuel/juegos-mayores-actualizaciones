# ==============================================================================
# Variables de Entorno - Frontend Juegos (Mayores Actualizaciones)
# ==============================================================================

# URL del backend de la plataforma utilizado por el proxy de desarrollo en Vite
# Local: http://localhost:8082
VITE_BACKEND_URL=http://localhost:8082

# URL Base para peticiones API cuando se compila la APK nativa (Capacitor)
# En Web, si se deja vacío o no se define, se usan URLs relativas automáticas (/api/...)
# VITE_API_URL=https://mayoresactualizaciones.asistodo.com.ar

# URL de retorno al Panel Central de Autenticación vía SSO
# Local: http://localhost:5173
# Producción: https://autenticador.asistodo.com.ar
VITE_AUTH_FRONTEND_URL=https://autenticador.asistodo.com.ar

# URLs específicas de assets o submódulos (Opcional, por defecto relativo)
# VITE_NARRATIVE_API_URL=/api/narrative
# VITE_ASSETS_BASE_URL=
